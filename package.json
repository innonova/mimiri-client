{
	"name": "webclient-vue",
	"version": "2.6.27",
	"minElectronVersionWin32": "2.6.1",
	"minElectronVersionDarwin": "2.6.22",
	"minElectronVersionLinux": "2.6.1",
	"minIosVersion": "2.3.1",
	"minAndroidVersion": "2.3.1",
	"iosVersion": "2.5.12",
	"androidVersion": "2.5.12",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite --host",
		"prettier": "prettier --end-of-line auto --check \"**/*.(ts|js|cjs|mjs|vue)\"",
		"build": "run-p type-check \"build-only {@}\" --",
		"preview": "vite preview",
		"build-only": "vite build",
		"build-dev": "NODE_ENV=development vite build",
		"type-check": "vue-tsc --build --force",
		"lint": "eslint --ext .ts,.js,.vue src",
		"test": "jest",
		"e2e": "playwright test --retries=1",
		"e2e-ss-update": "playwright test --update-snapshots",
		"icons-import": "node ./scripts/icons",
		"icons-list": "node ./scripts/create-icon-list.js",
		"cap-sync": "npx cap sync",
		"cap-sync-dev": "NODE_ENV=development npx cap sync",
		"ios": "npx cap open ios",
		"android": "npx cap open android",
		"sync": "run-s build cap-sync",
		"sync-dev": "run-s build-dev cap-sync-dev",
		"sync-prod": "run-s download-bundle unpack-bundle update-version-info cap-sync",
		"update-bundle": "node scripts/update-bundle.js",
		"download-bundle": "node scripts/download-bundle.js",
		"unpack-bundle": "node scripts/unpack-bundle.js",
		"update-version-info": "node scripts/update-version-info.js",
		"set-version": "node ./scripts/set-version",
		"make-bundle": "node ./scripts/make-bundle",
		"pack-bundle": "node ./scripts/pack-bundle",
		"create-key": "node ./scripts/create-key",
		"deploy-web": "node ./scripts/deploy-web",
		"demo": "npx playwright test -c playwright.demo.config.ts",
		"process-screenshots": "node ./scripts/process-screenshots.js",
		"create-screenshots": "npm run demo && npm run process-screenshots"
	},
	"dependencies": {
		"@capacitor/android": "^8.3.4",
		"@capacitor/app": "^8.1.0",
		"@capacitor/core": "^8.3.4",
		"@capacitor/ios": "^8.3.4",
		"@capacitor/keyboard": "^8.0.3",
		"@microsoft/signalr": "^10.0.0",
		"@vueuse/core": "14.3.0",
		"assert": "2.1.0",
		"date-fns": "^4.3.0",
		"idb": "^8.0.3",
		"js-base64": "^3.7.8",
		"monaco-editor": "^0.55.1",
		"node-diff3": "^3.2.0",
		"prosemirror-commands": "^1.7.1",
		"prosemirror-dropcursor": "^1.8.2",
		"prosemirror-gapcursor": "^1.4.1",
		"prosemirror-history": "^1.5.0",
		"prosemirror-inputrules": "^1.5.1",
		"prosemirror-keymap": "^1.2.3",
		"prosemirror-model": "^1.25.7",
		"prosemirror-schema-list": "^1.5.1",
		"prosemirror-search": "^1.1.1",
		"prosemirror-state": "^1.4.4",
		"prosemirror-view": "^1.41.8",
		"shiki": "^4.1.0",
		"uuid": "^14.0.0",
		"vscode-oniguruma": "^2.0.1",
		"vscode-textmate": "^9.3.2",
		"vue": "^3.5.35",
		"vue-router": "^5.1.0",
		"zxcvbn": "^4.4.2"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.3.4",
		"@jest/globals": "^30.4.1",
		"@playwright/test": "1.60.0",
		"@tailwindcss/postcss": "^4.3.0",
		"@tsconfig/node18": "18.2.6",
		"@types/crypto-js": "4.2.2",
		"@types/node": "25.9.1",
		"@types/uuid": "^11.0.0",
		"@typescript-eslint/eslint-plugin": "^8.60.0",
		"@typescript-eslint/parser": "^8.60.0",
		"@vitejs/plugin-vue": "^6.0.7",
		"@vitejs/plugin-vue-jsx": "^5.1.5",
		"@vue/eslint-config-typescript": "^14.7.0",
		"@vue/tsconfig": "0.9.1",
		"dotenv": "^17.4.2",
		"eslint": "10.4.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier-vue": "5.0.0",
		"eslint-plugin-vue": "^10.9.1",
		"html-entities": "^2.6.0",
		"jest": "^30.4.2",
		"jest-environment-jsdom": "^30.4.1",
		"jimp": "^1.6.1",
		"moment": "2.30.1",
		"npm-run-all2": "8.0.4",
		"postcss": "^8.5.23",
		"prettier": "3.8.3",
		"sharp": "^0.35.0",
		"shelljs": "^0.10.0",
		"tailwindcss": "^4.3.0",
		"ts-jest": "^29.4.11",
		"typescript": "6.0.3",
		"vite": "^8.0.14",
		"vite-plugin-vue-devtools": "^8.1.2",
		"vue-tsc": "^3.3.2"
	},
	"overrides": {
		"dompurify": "^3.4.13",
		"replace": {
			"minimatch": "^10.2.5"
		},
		"@capacitor/assets": {
			"sharp": "^0.35.0",
			"@capacitor/cli": {
				"tar": "^7.5.22"
			}
		},
		"@istanbuljs/load-nyc-config": {
			"js-yaml": "^3.15.1"
		},
		"xcode": {
			"uuid": "^11.1.1"
		}
	}
}
